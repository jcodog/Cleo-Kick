{
  "name": "kick-bot",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev",
    "deploy": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "bun run tsc --noEmit",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "coverage": "bunx vitest run --coverage --reporter=default --reporter=json --outputFile coverage/vitest-report.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@jconet-ltd/mailchannels-client": "^1.1.1",
    "@logtail/node": "^0.5.6",
    "@prisma/client": "^7.0.1",
    "@prisma/client-runtime-utils": "^7.0.1",
    "@prisma/extension-accelerate": "^3.0.0",
    "dotenv": "^16.6.1",
    "hono": "^4.10.7",
    "kick-api-types": "^1.0.12",
    "socket.io": "^4.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251128.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.14",
    "prisma": "^7.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "wrangler": "^4.51.0"
  }
}
